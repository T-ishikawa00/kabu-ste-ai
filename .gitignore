# Future additions only: .gitignore does NOT remove files already tracked in Git.
# Preserve the historical private repository until security review and backup.

# Python and local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
build/
dist/

# Local editor/OS state
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local credentials, OAuth, API keys and machine-specific configuration
.env
.env.*
!.env.example
credentials.json
token.pickle
token*.pickle
*.pem
*.key
*.p12
*.pfx
config.local.yaml
config.local.yml
*secret*.json
*credential*.json

# Operational records and market/training datasets (large or potentially private)
logs/
tb_logs/
tensorboard_logs/
reports/
config_backup/
data/
data_raw/
data_archive_daily/
data_archive_daily_backup/
today.csv/
backtest_results/

# Trained artifacts and generated output
model/
runtime/
*.sqlite
*.sqlite3
*.db
*.npz
*.pkl

# Always review unexpected generated files before sharing a repository.
